 # Firebase Service Account Credentials
# These environment variables take precedence over the local JSON file.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"

# Option 1 (RECOMMENDED for Vercel): Base64-encoded private key
# Generate with: cat service-account.json | jq -r '.private_key' | base64 -w 0
FIREBASE_PRIVATE_KEY_BASE64=""

# Option 2: Raw private key with escaped newlines (may have issues on some platforms)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
